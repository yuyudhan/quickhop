#!/usr/bin/env bash
# Enable with: just install-hooks (sets core.hooksPath to .githooks).
# Runs `just check` on the staged tree, exported to target/hook-tree/: unstaged edits and
# untracked files (yours or anyone else's in a shared clone) are neither checked nor fatal.
set -euo pipefail
exec scripts/hook-tree.sh commit just check
